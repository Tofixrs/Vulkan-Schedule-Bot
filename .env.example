# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env`.

# Base URL of the schedule site. `LIST_URL` is derived from this.
BASE_URL=https://example.com/plan

# --- Single class ---
# Class identifier as shown on the schedule list page.
CLASS=your-class

# Comma or newline separated Discord webhook URLs that receive the rendered plan.
# Legacy name `ANNOUNCE_URL` is also supported.
WEBHOOKS=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Multiple classes (optional) ---
# When CLASS_WEBHOOKS is set, CLASS and WEBHOOKS above are ignored.
# Separate classes with `;` or newlines. A comma separates multiple webhooks
# for the same class.
# CLASS_WEBHOOKS="class-a=https://discord.com/api/webhooks/000000000000000000/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;class-b=https://discord.com/api/webhooks/000000000000000000/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# Webhook used for status and error logs.
LOG_URL=https://discord.com/api/webhooks/000000000000000000/yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Discord user ID to ping when a fatal error occurs.
LOG_PING_ID=000000000000000000

# Milliseconds between checks. Defaults to 60000 ms (1 minute).
# CHECK_INTERVAL_MS=60000

# Run one check and exit. Useful for testing.
# RUN_ONCE=1
